
AUTH_SECRET=replace-with-at-least-32-random-characters

# Auth.js GitHub login
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Public URL reachable by the Remotion rendering process
APP_BASE_URL=http://localhost:3000

# Filesystem persistence for self-hosting
ASSET_DIRECTORY=./data/assets
RENDER_DIRECTORY=./data/renders
REMOTION_BUNDLE_DIRECTORY=./remotion-bundle

# Limit uploads. Groq limits depend on the account tier.
MAX_UPLOAD_BYTES=100000000

# OpenCode Zen
OPENCODE_DEFAULT_MODEL=deepseek-v4-flash-free

# Rendering
RENDER_CONCURRENCY=50%
REMOTION_LICENSE_KEY=


